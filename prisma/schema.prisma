generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Attendance {
  uuid     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user     User     @relation(fields: [userId], references: [email])
  userId   String
  dateTime DateTime @default(now())
}

model User {
  email       String       @id
  branch      Branch       @relation(fields: [branchId], references: [id])
  branchId    BigInt
  firstName   String
  lastName    String
  password    String       @db.VarChar(60)
  role        Role         @default(STAFF)
  attendances Attendance[]
}

enum Role {
  STAFF         @map("staff")
  MANAGER       @map("manager")
  ADMINISTRATOR @map("administrator")
}

model Branch {
  id       BigInt  @id @default(autoincrement()) @db.BigInt
  password String  @db.VarChar(60)
  User     User[]
  Stock    Stock[]
  Order    Order[]
}

model Stock {
  branch   Branch @relation(fields: [branchId], references: [id])
  branchId BigInt
  recipe   Recipe @relation(fields: [recipeId], references: [name])
  recipeId String
  quantity Int

  @@id([branchId, recipeId])
}

model Recipe {
  name       String       @id
  imagePath  String       @unique
  Stock      Stock[]
  MenuRecipe MenuRecipe[]
}

model MenuRecipe {
  menu     Menu   @relation(fields: [menuId], references: [id])
  menuId   BigInt
  recipe   Recipe @relation(fields: [recipeId], references: [name])
  recipeId String
  amount   Int

  @@id([menuId, recipeId])
}

model Menu {
  id         BigInt       @id @default(autoincrement()) @db.BigInt
  name       String       @unique
  price      Float        @db.DoublePrecision
  type       String
  fileName   String
  MenuRecipe MenuRecipe[]
  OrderMenu  OrderMenu[]
}

model OrderMenu {
  order    Order  @relation(fields: [orderId], references: [uuid])
  orderId  String
  menu     Menu   @relation(fields: [menuId], references: [id])
  menuId   BigInt
  quantity Int

  @@id([orderId, menuId])
}

model Order {
  uuid       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch     Branch      @relation(fields: [branchId], references: [id])
  branchId   BigInt
  timestamp  BigInt      @default(dbgenerated("(extract(epoch from now())*1000)::bigint")) @db.BigInt
  totalPrice Float       @db.DoublePrecision
  OrderMenu  OrderMenu[]
}
