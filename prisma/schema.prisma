generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Attendance {
  uuid      String   @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  user      User    @relation(fields: [userId], references: [uuid])
  userId    String
  dateTime  DateTime @default(now())
}

model User {
  uuid          String        @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  branch        Branch        @relation(fields: [branchId], references: [id])
  branchId      BigInt
  firstName     String
  lastName      String
  password      String        @db.VarChar(60)
  role          Role          @default(STAFF)
  attendances   Attendance[]
}

enum Role {
  STAFF           @map("staff")
  MANAGER         @map("manager")
  ADMINISTRATOR   @map("administrator")
}

model Branch {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  password    String    @db.VarChar(60)  
  User        User[]
  Stock       Stock[]
}

model Stock {
  branch   Branch @relation(fields: [branchId], references: [id])
  branchId BigInt
  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId BigInt
  quantity Int

  @@id([branchId, recipeId])
}

model Recipe {
  id         BigInt          @id @default(autoincrement()) @db.BigInt
  name       String       @unique
  Stock      Stock[]
  MenuRecipe MenuRecipe[]
}

model MenuRecipe {
  menu     Menu   @relation(fields: [menuId], references: [id])
  menuId   BigInt
  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId BigInt
  amount   Int

  @@id([menuId, recipeId])
}

model Menu {
  id         BigInt          @id @default(autoincrement()) @db.BigInt
  name       String       @unique
  price      Float        @db.DoublePrecision
  type       String
  fileName   String
  MenuRecipe MenuRecipe[]
  OrderMenu  OrderMenu[]
}

model OrderMenu {
  order    Order  @relation(fields: [orderId], references: [uuid])
  orderId  String
  menu     Menu   @relation(fields: [menuId], references: [id])
  menuId   BigInt
  quantity Int

  @@id([orderId, menuId])
}

model Order {
  uuid       String      @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  timestamp  BigInt      @db.BigInt @default(dbgenerated("(extract(epoch from now())*1000)::bigint"))
  totalPrice Float       @db.DoublePrecision
  OrderMenu  OrderMenu[]
}
